#!/bin/sh
# generate-context -- concatenate files with headers (alpine ash compatible)
set -eu

VERSION="1.0.0"
INCLUDE_BINARY=0
PATHS=""

usage() {
  cat <<'EOF'
Usage: generate-context [options] [paths...]

Concatenate contents of multiple files, globs, or directories with filename headers

Options:
  --include-binary    Include binary files in the output (not recommended)
  --exclude-binary    Exclude binary files from the output (default behavior)
  --help              Show this help message
  --version           Show version

Arguments:
  paths               File names, globs, or directories to concatenate
EOF
}

# argument parsing ----------------------------------------------------
add_path() {
  if [ -z "$PATHS" ]; then
    PATHS="$1"
  else
    PATHS="$PATHS
$1"
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --include-binary) INCLUDE_BINARY=1; shift ;;
    --exclude-binary) INCLUDE_BINARY=0; shift ;;
    --help) usage; exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    -*) echo "Error: Unknown option: $1" >&2; exit 1 ;;
    *) add_path "$1"; shift ;;
  esac
done

if [ -z "$PATHS" ]; then
  echo "Error: No paths specified" >&2
  exit 1
fi

# --------------------------------------------------------------------
# helper functions
# --------------------------------------------------------------------
canonicalize() {
  # output canonical absolute path, fallback to original if unavailable
  readlink -f "$1" 2>/dev/null || echo "$1"
}

expand_path() {
  # Prints one existing file path per line for a given pattern/directory.
  pattern="$1"
  if [ -d "$pattern" ]; then
    find "$pattern" -type f -print 2>/dev/null
    return
  fi

  # If the pattern contains no wildcards, treat it as a literal path
  case "$pattern" in
    *\**|*\?*|*\**)
      # globbing: unquoted expansion (pattern must not contain spaces)
      found=0
      for f in $pattern; do
        if [ -e "$f" ]; then
          printf '%s\n' "$f"
          found=1
        fi
      done
      # If no matches, and the literal string is a file, output it
      if [ "$found" -eq 0 ] && [ -f "$pattern" ]; then
        printf '%s\n' "$pattern"
      fi
      ;;
    *)
      # literal path: just check if it exists
      if [ -f "$pattern" ]; then
        printf '%s\n' "$pattern"
      fi
      ;;
  esac
}

is_binary() {
  # Returns 0 (true) if the file looks binary, 1 (false) otherwise.
  file="$1"

  [ ! -s "$file" ] && return 1   # empty files are treated as text

  # check for null bytes in first 8KB
  total=$(head -c 8192 "$file" 2>/dev/null | wc -c)
  nonull=$(head -c 8192 "$file" 2>/dev/null | tr -d '\000' | wc -c)
  if [ "$total" -ne "$nonull" ]; then
    return 0
  fi

  # No null bytes found -- treat as text
  return 1
}

# --------------------------------------------------------------------
# main logic
# --------------------------------------------------------------------
rawfile=$(mktemp) || exit 1
dedupfile=$(mktemp) || exit 1
textfile=$(mktemp) || exit 1
trap 'rm -f "$rawfile" "$dedupfile" "$textfile"' EXIT

# 1. expand patterns/directories -> canonical absolute paths
{
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    expand_path "$p" | while IFS= read -r f; do
      canonicalize "$f"
    done
  done <<EOF
$PATHS
EOF
} > "$rawfile"

# 2. deduplicate, preserving order
awk '!seen[$0]++' "$rawfile" > "$dedupfile"

# 3. filter binary files
skipped=0
> "$textfile"  # empty the file
while IFS= read -r f; do
  if [ "$INCLUDE_BINARY" -eq 1 ] || ! is_binary "$f"; then
    printf '%s\n' "$f" >> "$textfile"
  else
    skipped=$((skipped + 1))
  fi
done < "$dedupfile"

if [ ! -s "$textfile" ]; then
  echo "Error: No text files found" >&2
  exit 1
fi

if [ "$INCLUDE_BINARY" -eq 0 ] && [ "$skipped" -gt 0 ]; then
  echo "Skipped $skipped binary file(s). Use --include-binary to include them." >&2
fi

# 4. generate context output
total=$(wc -l < "$textfile")
i=1
while IFS= read -r file; do
  # Try to get a relative path, fallback to original
  display_path=$(realpath --relative-to=. "$file" 2>/dev/null || echo "$file")
  printf '%s:\n```\n' "$display_path"
  cat "$file" 2>/dev/null || echo "Error: Could not read $file" >&2
  printf '```\n'
  if [ "$i" -lt "$total" ]; then
    echo
  fi
  i=$((i + 1))
done < "$textfile"