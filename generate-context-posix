#!/bin/sh

set -eu

VERSION="1.0.0"
INCLUDE_BINARY=false
# Use a temp file to collect paths since POSIX sh lacks arrays
PATHS_FILE=$(mktemp)
trap 'rm -f "$PATHS_FILE"' EXIT

usage() {
    cat <<EOF
Usage: generate-context [options] [paths...]

Concatenate contents of multiple files, globs, or directories with filename headers

Options:
  --include-binary    Include binary files in the output (not recommended)
  --exclude-binary    Exclude binary files from the output (default behavior)
  --help              Show this help message
  --version           Show version

Arguments:
  paths               File names, globs, or directories to concatenate
EOF
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --include-binary)
            INCLUDE_BINARY=true
            shift
            ;;
        --exclude-binary)
            INCLUDE_BINARY=false
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        --version)
            echo "$VERSION"
            exit 0
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            exit 1
            ;;
        *)
            printf '%s\n' "$1" >> "$PATHS_FILE"
            shift
            ;;
    esac
done

if [ ! -s "$PATHS_FILE" ]; then
    echo "Error: No paths specified" >&2
    exit 1
fi

# Expand a single pattern/path into actual files, printed to stdout one per line.
# Each line is NUL-terminated to handle filenames with newlines.
expand_path() {
    pattern="$1"

    # Check if it's a directory
    if [ -d "$pattern" ]; then
        find "$pattern" -type f -print
        return
    fi

    # Try glob expansion via set --
    # Save and restore positional parameters around this
    set +f
    # shellcheck disable=SC2086
    set -- $pattern
    set -f

    # If glob expanded to something real, print each match
    if [ -e "$1" ]; then
        for f do
            [ -e "$f" ] && printf '%s\n' "$f"
        done
        return
    fi

    # If the literal path exists as a file, print it
    if [ -f "$pattern" ]; then
        printf '%s\n' "$pattern"
    fi
}

# Check if a file is binary.
# Returns 0 (true) if binary, 1 (false) if text.
is_binary() {
    file="$1"

    # Empty files are treated as text
    if [ ! -s "$file" ]; then
        return 1
    fi

    # Check for null bytes in first 8KB using tr and wc
    # tr -d deletes the given chars; if the count changes there were null bytes
    first8k=$(head -c 8192 "$file" 2>/dev/null)
    without_nulls=$(printf '%s' "$first8k" | tr -d '\000' | wc -c)
    with_nulls=$(printf '%s' "$first8k" | wc -c)
    if [ "$with_nulls" -ne "$without_nulls" ]; then
        return 0
    fi

    # Check printable character ratio in first 1KB
    total=$(head -c 1024 "$file" 2>/dev/null | wc -c)
    if [ "$total" -eq 0 ]; then
        return 1
    fi

    printable=$(head -c 1024 "$file" 2>/dev/null | tr -cd '[:print:]\t\n\r' | wc -c)

    # If less than 80% printable, consider binary
    if [ $(( printable * 100 / total )) -lt 80 ]; then
        return 0
    fi

    return 1
}

# Resolve a path to an absolute path without relying on realpath(1)
abspath() {
    _path="$1"
    case "$_path" in
        /*)
            printf '%s\n' "$_path"
            ;;
        *)
            printf '%s/%s\n' "$(pwd)" "$_path"
            ;;
    esac
}

# Compute a path relative to the current directory without relying on realpath(1)
relative_to_cwd() {
    _abs="$1"
    _cwd="$(pwd)"
    # Strip leading cwd + slash if present
    case "$_abs" in
        "${_cwd}/")
            printf '.\n'
            ;;
        "${_cwd}/"|"${_cwd}")
            printf '%s\n' "${_abs#"${_cwd}/"}"
            ;;
        *)
            printf '%s\n' "$_abs"
            ;;
    esac
}

# Collect all files into a temp file (one path per line)
ALL_FILES=$(mktemp)
trap 'rm -f "$PATHS_FILE" "$ALL_FILES"' EXIT

set -f  # Disable glob expansion while reading paths
while IFS= read -r p; do
    set +f
    expand_path "$p" >> "$ALL_FILES"
    set -f
done < "$PATHS_FILE"
set +f

# Remove duplicates while preserving order.
# We use a second temp file and awk to track seen absolute paths.
UNIQUE_FILES=$(mktemp)
trap 'rm -f "$PATHS_FILE" "$ALL_FILES" "$UNIQUE_FILES"' EXIT

while IFS= read -r file; do
    [ -z "$file" ] && continue
    abs="$(abspath "$file")"
    printf '%s\t%s\n' "$abs" "$file"
done < "$ALL_FILES" | awk -F'\t' '!seen[$1]++ { print $2 }' > "$UNIQUE_FILES"

if [ ! -s "$UNIQUE_FILES" ]; then
    echo "Error: No matching files found" >&2
    exit 1
fi

# Filter binary files unless explicitly requested.
TEXT_FILES=$(mktemp)
trap 'rm -f "$PATHS_FILE" "$ALL_FILES" "$UNIQUE_FILES" "$TEXT_FILES"' EXIT

SKIPPED=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ "$INCLUDE_BINARY" = true ] || ! is_binary "$f"; then
        printf '%s\n' "$f" >> "$TEXT_FILES"
    else
        SKIPPED=$(( SKIPPED + 1 ))
    fi
done < "$UNIQUE_FILES"

if [ ! -s "$TEXT_FILES" ]; then
    echo "Error: No text files found" >&2
    exit 1
fi

if [ "$INCLUDE_BINARY" != true ] && [ "$SKIPPED" -gt 0 ]; then
    echo "Skipped $SKIPPED binary file(s). Use --include-binary to include them." >&2
fi

# Count lines for last-index detection
TOTAL=$(wc -l < "$TEXT_FILES")
INDEX=0

while IFS= read -r file; do
    INDEX=$(( INDEX + 1 ))
    abs="$(abspath "$file")"
    display_path="$(relative_to_cwd "$abs")"

    printf '%s:\n' "$display_path"
    printf '```\n'
    cat "$file" 2>/dev/null || echo "Error: Could not read $file" >&2
    printf '```\n'

    if [ "$INDEX" -lt "$TOTAL" ]; then
        echo
    fi
done < "$TEXT_FILES"