#!/bin/sh

set -eu

VERSION="1.0.0"
INCLUDE_BINARY=false

# Temp files substituting for arrays
PATHS_FILE=$(mktemp)
ALL_FILES=$(mktemp)
UNIQUE_FILES=$(mktemp)
TEXT_FILES=$(mktemp)
trap 'rm -f "$PATHS_FILE" "$ALL_FILES" "$UNIQUE_FILES" "$TEXT_FILES"' EXIT INT TERM

usage() {
    cat <<EOF
Usage: generate-context [options] [paths...]

Concatenate contents of multiple files, globs, or directories with filename headers

Options:
  --include-binary    Include binary files in the output (not recommended)
  --exclude-binary    Exclude binary files from the output (default behavior)
  --help              Show this help message
  --version           Show version

Arguments:
  paths               File names, globs, or directories to concatenate
EOF
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --include-binary)
            INCLUDE_BINARY=true
            shift
            ;;
        --exclude-binary)
            INCLUDE_BINARY=false
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        --version)
            echo "$VERSION"
            exit 0
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            exit 1
            ;;
        *)
            printf '%s\n' "$1" >> "$PATHS_FILE"
            shift
            ;;
    esac
done

if [ ! -s "$PATHS_FILE" ]; then
    echo "Error: No paths specified" >&2
    exit 1
fi

# Read N bytes from a file into stdout.
# Usage: read_bytes FILE N
# Uses dd which is universally available, including BusyBox.
read_bytes() {
    dd if="$1" bs=1 count="$2" 2>/dev/null
}

# Expand a single pattern/path into actual files, one per line on stdout
expand_path() {
    pattern="$1"

    if [ -d "$pattern" ]; then
        find "$pattern" -type f -print
        return
    fi

    # Glob expansion: temporarily enable globbing
    set +f
    for f in $pattern; do
        set -f
        if [ -e "$f" ]; then
            printf '%s\n' "$f"
        elif [ -f "$pattern" ]; then
            printf '%s\n' "$pattern"
        fi
        set +f
    done
    set -f
}

# Check if a file is binary.
# Returns 0 (true) if binary, 1 (false) if text.
is_binary() {
    file="$1"

    # Empty files are treated as text
    if [ ! -s "$file" ]; then
        return 1
    fi

    # Check for null bytes in first 8KB using dd + tr + wc
    first8k=$(read_bytes "$file" 8192)
    with_nulls=$(printf '%s' "$first8k" | wc -c)
    without_nulls=$(printf '%s' "$first8k" | tr -d '\000' | wc -c)
    if [ "$with_nulls" -ne "$without_nulls" ]; then
        return 0
    fi

    # Check printable character ratio in first 1KB
    first1k=$(read_bytes "$file" 1024)
    total=$(printf '%s' "$first1k" | wc -c)

    if [ "$total" -eq 0 ]; then
        return 1
    fi

    printable=$(printf '%s' "$first1k" | tr -cd '[:print:]\t\n\r' | wc -c)

    # If less than 80% printable, consider binary
    if [ $(( printable * 100 / total )) -lt 80 ]; then
        return 0
    fi

    return 1
}

# Resolve a path to an absolute path
abspath() {
    _path="$1"
    case "$_path" in
        /*)
            printf '%s\n' "$_path"
            ;;
        *)
            printf '%s/%s\n' "$(pwd)" "$_path"
            ;;
    esac
}

# Compute a path relative to the current directory
relative_to_cwd() {
    _abs="$1"
    _cwd="$(pwd)"
    case "$_abs" in
        "${_cwd}/")
            printf '.\n'
            ;;
        "${_cwd}/"*|"${_cwd}")
            printf '%s\n' "${_abs#"${_cwd}/"}"
            ;;
        *)
            printf '%s\n' "$_abs"
            ;;
    esac
}

# Collect all files
set -f
while IFS= read -r p; do
    set +f
    expand_path "$p" >> "$ALL_FILES"
    set -f
done < "$PATHS_FILE"
set +f

# Deduplicate while preserving order using awk
while IFS= read -r file; do
    [ -z "$file" ] && continue
    abs="$(abspath "$file")"
    printf '%s\t%s\n' "$abs" "$file"
done < "$ALL_FILES" | awk -F'\t' '!seen[$1]++ { print $2 }' > "$UNIQUE_FILES"

if [ ! -s "$UNIQUE_FILES" ]; then
    echo "Error: No matching files found" >&2
    exit 1
fi

# Filter binary files unless explicitly requested
SKIPPED=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ "$INCLUDE_BINARY" = true ] || ! is_binary "$f"; then
        printf '%s\n' "$f" >> "$TEXT_FILES"
    else
        SKIPPED=$(( SKIPPED + 1 ))
    fi
done < "$UNIQUE_FILES"

if [ ! -s "$TEXT_FILES" ]; then
    echo "Error: No text files found" >&2
    exit 1
fi

if [ "$INCLUDE_BINARY" != true ] && [ "$SKIPPED" -gt 0 ]; then
    echo "Skipped $SKIPPED binary file(s). Use --include-binary to include them." >&2
fi

# Generate output
TOTAL=$(wc -l < "$TEXT_FILES")
INDEX=0

while IFS= read -r file; do
    INDEX=$(( INDEX + 1 ))
    abs="$(abspath "$file")"
    display_path="$(relative_to_cwd "$abs")"

    printf '%s:\n' "$display_path"
    printf '```\n'
    cat "$file" 2>/dev/null || echo "Error: Could not read $file" >&2
    printf '```\n'

    if [ "$INDEX" -lt "$TOTAL" ]; then
        echo
    fi
done < "$TEXT_FILES"