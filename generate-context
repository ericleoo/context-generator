#!/usr/bin/env bash

set -euo pipefail

VERSION="1.0.0"
INCLUDE_BINARY=false
PATHS=()

usage() {
  cat <<EOF
Usage: generate-context [options] [paths...]

Concatenate contents of multiple files, globs, or directories with filename headers

Options:
  --include-binary    Include binary files in the output (not recommended)
  --exclude-binary    Exclude binary files from the output (default behavior)
  --help              Show this help message
  --version           Show version

Arguments:
  paths               File names, globs, or directories to concatenate
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --include-binary)
      INCLUDE_BINARY=true
      shift
      ;;
    --exclude-binary)
      INCLUDE_BINARY=false
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    --version)
      echo "$VERSION"
      exit 0
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      exit 1
      ;;
    *)
      PATHS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#PATHS[@]} -eq 0 ]]; then
  echo "Error: No paths specified" >&2
  exit 1
fi

# Expand a single pattern/path into actual files
expand_path() {
  local pattern="$1"
  local -a result=()

  # Check if it's a directory
  if [[ -d "$pattern" ]]; then
    while IFS= read -r -d '' file; do
      result+=("$file")
    done < <(find "$pattern" -type f -print0 2>/dev/null)
    printf '%s\n' "${result[@]}"
    return
  fi

  # Try glob expansion (use compgen for portability)
  local -a matches=()
  for f in $pattern; do
    if [[ -e "$f" ]]; then
      matches+=("$f")
    fi
  done

  if [[ ${#matches[@]} -gt 0 ]]; then
    printf '%s\n' "${matches[@]}"
  elif [[ -f "$pattern" ]]; then
    echo "$pattern"
  fi
}

# Check if a file is binary
is_binary() {
  local file="$1"

  # Empty files are treated as text
  if [[ ! -s "$file" ]]; then
    return 1
  fi

  # Check for null bytes in first 8KB
  if head -c 8192 "$file" | grep -qP '\x00'; then
    return 0
  fi

  # Check printable character ratio in first 1KB
  local total printable printable_ratio
  total=$(head -c 1024 "$file" | wc -c)
  if [[ "$total" -eq 0 ]]; then
    return 1
  fi

  printable=$(head -c 1024 "$file" | tr -cd '[:print:]\t\n\r' | wc -c)
  # If less than 80% printable, consider binary
  if [[ $((printable * 100 / total)) -lt 80 ]]; then
    return 0
  fi

  return 1
}

# Collect all files
ALL_FILES=()
for p in "${PATHS[@]}"; do
  while IFS= read -r file; do
    [[ -n "$file" ]] && ALL_FILES+=("$file")
  done < <(expand_path "$p")
done

# Remove duplicates while preserving order
declare -A SEEN
UNIQUE_FILES=()
for f in "${ALL_FILES[@]}"; do
  # Normalize path to absolute for dedup
  local_path="$f"
  if [[ -e "$f" ]]; then
    local_path="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
  fi
  if [[ -z "${SEEN[$local_path]+x}" ]]; then
    SEEN[$local_path]=1
    UNIQUE_FILES+=("$f")
  fi
done

if [[ ${#UNIQUE_FILES[@]} -eq 0 ]]; then
  echo "Error: No matching files found" >&2
  exit 1
fi

# Filter binary files unless explicitly requested
TEXT_FILES=()
SKIPPED=0

for f in "${UNIQUE_FILES[@]}"; do
  if [[ "$INCLUDE_BINARY" == true ]] || ! is_binary "$f"; then
    TEXT_FILES+=("$f")
  else
    ((SKIPPED++)) || true
  fi
done

if [[ ${#TEXT_FILES[@]} -eq 0 ]]; then
  echo "Error: No text files found" >&2
  exit 1
fi

if [[ "$INCLUDE_BINARY" != true ]] && [[ $SKIPPED -gt 0 ]]; then
  echo "Skipped $SKIPPED binary file(s). Use --include-binary to include them." >&2
fi

# Generate context output
LAST_INDEX=$(( ${#TEXT_FILES[@]} - 1 ))
for i in "${!TEXT_FILES[@]}"; do
  file="${TEXT_FILES[$i]}"
  display_path="$(realpath --relative-to=. "$file" 2>/dev/null || echo "$file")"

  echo "${display_path}:"
  echo '```'
  cat "$file" 2>/dev/null || echo "Error: Could not read $file" >&2
  echo '```'

  if [[ $i -lt $LAST_INDEX ]]; then
    echo
  fi
done
